# Copie para .env.local e preencha. NUNCA faça commit do .env.local.
# Sem as variáveis do Supabase, o app roda em modo local (dados só no aparelho).
# Sem ANTHROPIC_API_KEY, o diagnóstico fica em modo demonstração.

# ── Supabase (Project Settings → API Keys) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# chave secreta (sb_secret_...). Só servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Endereço público do app (links dos e-mails de login) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Diagnóstico por foto (console.anthropic.com → API Keys) ──
ANTHROPIC_API_KEY=
# opcionais: modelo padrão e modelo usado nos casos ambíguos
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MODEL_STRONG=claude-sonnet-5-5
DAILY_DIAGNOSIS_LIMIT=20

# ── Job diário (Vercel Cron manda "Authorization: Bearer $CRON_SECRET") ──
# gere com: openssl rand -hex 32
CRON_SECRET=

# ── Notificações (gere com: npx web-push generate-vapid-keys) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
